# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the client / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Drizzle) -------------------------------------------------------
# Project Settings > Database > Connection Pooling in the Supabase dashboard.
# NOTE: the "direct connection" host (db.<ref>.supabase.co) is IPv6-only on
# Supabase's free tier — it will fail with ENOTFOUND on any network without
# outbound IPv6 (common on home/office networks and some CI runners). Use the
# Supavisor pooler host (aws-0-<region>.pooler.supabase.com) for both URLs
# below instead; it works over IPv4.
# DATABASE_URL: transaction-mode pooler (port 6543), used by the app at runtime.
# connection_limit caps how many concurrent connections THIS app instance can
# open to the pooler. 1 seemed safe early on but it forces every Promise.all
# of independent queries (e.g. dashboard.service.ts) to serialize over a
# single connection instead of actually running in parallel — bumped to 10.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# DIRECT_URL: session-mode pooler (port 5432), used only for running migrations.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Financial data providers ------------------------------------------------
# mock: use seeded fixture data only. live: use real Finnhub (US/international)
# + NGN Market (NGX) quotes, falling back to mock per-security whenever the
# live provider can't serve a request. See docs/market-data-providers.md for
# exactly what each provider covers, free-tier limits, and what still needs a
# paid plan. Get keys at finnhub.io and docs.ngnmarket.com.
PROVIDER_MODE=mock
FINNHUB_API_KEY=
NGN_MARKET_API_KEY=

# --- Rate limiting (added when Upstash is wired up, Phase 1+) ----------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Email (added in Phase 6) -------------------------------------------------
# RESEND_API_KEY=
