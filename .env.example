# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the client / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Drizzle) -------------------------------------------------------
# Project Settings > Database in the Supabase dashboard.
# DATABASE_URL: pooled connection (PgBouncer, port 6543) used by the app at runtime.
DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: direct connection (port 5432) used only for running migrations.
DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Financial data providers (Phase 3+) -------------------------------------
# mock: use fixture data (default for Phase 0-5). live: use real adapters (Phase 6+).
PROVIDER_MODE=mock

# --- Rate limiting (added when Upstash is wired up, Phase 1+) ----------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Email (added in Phase 6) -------------------------------------------------
# RESEND_API_KEY=
