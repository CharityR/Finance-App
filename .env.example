# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the client / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Drizzle) -------------------------------------------------------
# Project Settings > Database > Connection Pooling in the Supabase dashboard.
# NOTE: the "direct connection" host (db.<ref>.supabase.co) is IPv6-only on
# Supabase's free tier — it will fail with ENOTFOUND on any network without
# outbound IPv6 (common on home/office networks and some CI runners). Use the
# Supavisor pooler host (aws-0-<region>.pooler.supabase.com) for both URLs
# below instead; it works over IPv4.
# DATABASE_URL: transaction-mode pooler (port 6543), used by the app at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: session-mode pooler (port 5432), used only for running migrations.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Financial data providers (Phase 3+) -------------------------------------
# mock: use fixture data (default for Phase 0-5). live: use real adapters (Phase 6+).
PROVIDER_MODE=mock

# --- Rate limiting (added when Upstash is wired up, Phase 1+) ----------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Email (added in Phase 6) -------------------------------------------------
# RESEND_API_KEY=
